# --- PLATFORM: RAILWAY BACKEND API ---
# Copy everything below and paste into Railway -> Variables -> Bulk Import

ENVIRONMENT=production
PYTHONPATH=.

# DB & CACHE
DATABASE_URL=PASTE_YOUR_RAILWAY_POSTGRES_URL_HERE
REDIS_URL=PASTE_YOUR_UPSTASH_REDIS_URL_HERE

# SUPABASE AUTH
SUPABASE_URL=PASTE_YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_KEY=PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# SECURITY & CORS
JWT_SECRET_KEY=PASTE_A_LONG_RANDOM_STRING_HERE
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# EXTERNAL API (IRCTC Sync)
RAPIDAPI_KEY=PASTE_YOUR_RAPID_API_KEY_HERE
RAPIDAPI_HOST=irctc1.p.rapidapi.com
# optional override to force a specific RapidAPI endpoint version (v1, v2 or v3)
# if left blank the service will auto-detect the first working version and cache it.
RAPIDAPI_PREFERRED_VERSION=v1

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCOUNT_ID=1e80a967148b02852d23bab933c93973
CLOUDFLARE_R2_S3_API=https://1e80a967148b02852d23bab933c93973.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=a464777c545212fc79ecad05337277e0
CLOUDFLARE_R2_SECRET_ACCESS_KEY=1b3bcb717180c7e873a9ad552db8df6f959f235154f1babdf108b4ed3e7df306
CLOUDFLARE_R2_BUCKET_NAME=routemaster-storage

{
  "include": ["backend", "."],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "backend/.venv"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": ["."],
      "venvPath": "backend",
      "venv": ".venv"
    }
  ],
  "extraPaths": ["backend", "./backend"]
}
